{
  "expo": {
    "name": "IntelliCam",
    "slug": "IntelliCam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-concepts/intellicam-icon-concept-01.png",
    "scheme": "intellicam",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "IntelliCam needs camera access to capture photos.",
        "NSPhotoLibraryAddUsageDescription": "IntelliCam saves your captured photos to your photo library.",
        "NSLocationWhenInUseUsageDescription": "IntelliCam can optionally embed your location inside new photos when you turn Photo location on."
      }
    },
    "android": {
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ],
      "package": "com.wltechfreelance.IntelliCam"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-vision-camera-raw-props",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "IntelliCam can optionally embed your location inside new photos when you turn Photo location on."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "IntelliCam saves your captured photos to your photo library.",
          "savePhotosPermission": "IntelliCam saves your captured photos to your photo library.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f30bf86b-1770-4444-b001-37201ba7914b"
      }
    },
    "owner": "wltechfreelance"
  }
}
